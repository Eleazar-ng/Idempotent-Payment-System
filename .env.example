# Copy to .env for local development.
NODE_ENV=development

DATABASE_URL=postgres://payments:payments@localhost:5432/payments
REDIS_URL=redis://localhost:6379

API_PORT=3000
FAKE_PROCESSOR_PORT=3001

# Where the API/worker send outbound charge calls (the fake processor in dev).
PROCESSOR_BASE_URL=http://localhost:3001
# Processor call behaviour: wait this long, then retry UNKNOWN outcomes (same key) this many times.
PROCESSOR_TIMEOUT_MS=5000
PROCESSOR_CALL_RETRIES=2
PROCESSOR_RETRY_DELAY_MS=200
PROCESSOR_RETRY_MAX_DELAY_MS=2000
# The platform's fee on each successful payment, in basis points (150 = 1.5%). Booked to the ledger.
PLATFORM_FEE_BPS=150
# Shared secret for signing/verifying webhooks. Min 16 chars. Use a real random value outside local dev.
PROCESSOR_WEBHOOK_SECRET=local-dev-webhook-secret-change-me

# Optional: where the fake processor sends webhooks (the API's webhook endpoint, from Stage 7).
# Can also be set at runtime through the control API. Leave unset to deliver nowhere.
# FAKE_PROCESSOR_WEBHOOK_URL=http://localhost:3000/webhooks/processor

# Outbox relay (worker): delivers payment events to each merchant's webhook URL.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_MS=60000
OUTBOX_DELIVERY_TIMEOUT_MS=5000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=3600000